# =============================================================================
# PhotoShare API - Environment Variables
# Copy this file to .env and update values before running the application.
# =============================================================================

# Application
APP_ENV=development
DEBUG=true

# Database (async driver required: postgresql+asyncpg://)
# Local development:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/photoshare
# Docker Compose (api service overrides this automatically):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/photoshare

# JWT Authentication
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudinary (required for photo upload, transformations, and QR codes)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
